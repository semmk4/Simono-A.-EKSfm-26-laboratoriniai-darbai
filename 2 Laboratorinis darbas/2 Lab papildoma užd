clc
clear all
close all
%% 1. DUOMENŲ PARUOŠIMAS PAVIRŠIUI
% Sukuriame dviejų kintamųjų tinklelį (nuo 0 iki 1)
[X1, X2] = meshgrid(0:0.1:1, 0:0.1:1);

% Ištiesiname matricas į vienos eilutės vektorius, kad veiktų for ciklas
x1 = X1(:)'; 
x2 = X2(:)';

% Sugalvojame matematinę formulę paviršiui, kuri priklauso nuo x1 ir x2
d = sin(x1*pi) .* cos(x2*pi); 

% Nupiešiame originalų norimą paviršių mėlynais rutuliukais
figure;
plot3(x1, x2, d, 'bo');
grid on; hold on;
title('Paviršiaus aproksimavimas (2 įėjimai, 1 išėjimas)');
%% tinklo inicializavimnas

%pirmas sluoksnis

%pirmas įėjimas
w11_1 = rand(1);
w21_1 = rand(1);
w31_1 = rand(1);
w41_1 = rand(1);
w51_1 = rand(1);

%antras įėjimas
w12_1 = rand(1);
w22_1 = rand(1);
w32_1 = rand(1);
w42_1 = rand(1);
w52_1 = rand(1);

%poslinkiai pirmo sluoksnio
b1_1 = rand(1);
b2_1 = rand(1);
b3_1 = rand(1);
b4_1 = rand(1);
b5_1 = rand(1);

%antras sluoksnis
w11_2 = rand(1);
w12_2 = rand(1);
w13_2 = rand(1);
w14_2 = rand(1);
w15_2 = rand(1);
b1_2 = rand(1);
eta = 0.05;

%%tinklo atasakas
for iter=1:20000
    for i=1:length(x1)
        %1 sluoksnio pasvertos sumos
        v1_1= x1(i)*w11_1 + x2(i)*w12_1 + b1_1;
        v2_1= x1(i)*w21_1 + x2(i)*w22_1 + b2_1;
        v3_1= x1(i)*w31_1 + x2(i)*w32_1 + b3_1;
        v4_1= x1(i)*w41_1 + x2(i)*w42_1 + b4_1;
        v5_1= x1(i)*w51_1 + x2(i)*w52_1 + b5_1;
        %1sluoksnio aktyvacijos funkcijos
        y1_1 = tanh(v1_1);
        y2_1 = tanh(v2_1);
        y3_1 = tanh(v3_1);
        y4_1 = tanh(v4_1);
        y5_1 = tanh(v5_1);
        %2 sluoksnis pasverta suma
        v1_2 = y1_1 * w11_2 + y2_1 * w12_2 + y3_1 * w13_2 + y4_1 * w14_2 + y5_1 * w15_2 + b1_2;
        %išėjimo sluoksnio aktyvacija, tiesinė funkcija čia - išėjimas
        %proporcingas įėjimui
        y1_2=v1_2;
        %tinklo išėjimas
        y=y1_2;
        %klaida 
        e=d(i)-y;
        %%svoriu atnaujinimas
        %gradianto skaiciavimnas
        %isejimo sluoksnis
        delta1_2=e;
        %pasleptasis sluoksnis
        delta1_1 = (1 - (tanh(v1_1)^2)) * delta1_2 * w11_2;
        delta2_1 = (1 - (tanh(v2_1)^2)) * delta1_2 * w12_2;
        delta3_1 = (1 - (tanh(v3_1)^2)) * delta1_2 * w13_2;
        delta4_1 = (1 - (tanh(v4_1)^2)) * delta1_2 * w14_2;
        delta5_1 = (1 - (tanh(v5_1)^2)) * delta1_2 * w15_2;
        %atnaujinami svoriai
        %atnaujinami atbuline tvarka, pirma atnaujinamas išėjimo sluoksnis

        %išėjimo sluoksnio
        w11_2 = w11_2+eta*delta1_2*y1_1;
        w12_2 = w12_2+eta*delta1_2*y2_1;
        w13_2 = w13_2+eta*delta1_2*y3_1;
        w14_2 = w14_2+eta*delta1_2*y4_1;
        w15_2 = w15_2+eta*delta1_2*y5_1;
        b1_2 = b1_2 + eta*delta1_2;
        %paslepto sluoksnio
        w11_1 = w11_1 + eta*delta1_1 * x1(i);
        w21_1 = w21_1 + eta*delta2_1 * x1(i);
        w31_1 = w31_1 + eta*delta3_1 * x1(i);
        w41_1 = w41_1 + eta*delta4_1 * x1(i);
        w51_1 = w51_1 + eta*delta5_1 * x1(i);
        w12_1 = w12_1 + eta*delta1_1 * x2(i);
        w22_1 = w22_1 + eta*delta2_1 * x2(i);
        w32_1 = w32_1 + eta*delta3_1 * x2(i);
        w42_1 = w42_1 + eta*delta4_1 * x2(i);
        w52_1 = w52_1 + eta*delta5_1 * x2(i);
        b1_1 = b1_1 + eta*delta1_1;
        b2_1 = b2_1 + eta*delta2_1;
        b3_1 = b3_1 + eta*delta3_1;
        b4_1 = b4_1 + eta*delta4_1;
        b5_1 = b5_1 + eta*delta5_1;
    end
end

Y= zeros(1, length(x1));
for i=1:length(x1)
    % Apskaičiuojame išmoktą atsaką
    v1_1 = x1(i)*w11_1 + x2(i)*w12_1 + b1_1;
    v2_1 = x1(i)*w21_1 + x2(i)*w22_1 + b2_1;
    v3_1 = x1(i)*w31_1 + x2(i)*w32_1 + b3_1;
    v4_1 = x1(i)*w41_1 + x2(i)*w42_1 + b4_1;
    v5_1 = x1(i)*w51_1 + x2(i)*w52_1 + b5_1;

    y1_1 = tanh(v1_1); y2_1 = tanh(v2_1); y3_1 = tanh(v3_1); y4_1 = tanh(v4_1); y5_1 = tanh(v5_1);

    Y(i) = y1_1*w11_2 + y2_1*w12_2 + y3_1*w13_2 + y4_1*w14_2 + y5_1*w15_2 + b1_2;   
end

% Nupiešiame tinklo sugeneruotą paviršių raudonomis žvaigždutėmis
plot3(x1, x2, Y, 'r*');
legend('Norimas atsakas (Matematinė funkcija)', 'Tinklo atsakas (Aproksimacija)');
xlabel('Įėjimas x1');
ylabel('Įėjimas x2');
zlabel('Išėjimas y');
